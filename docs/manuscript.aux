\newlabel{tab:expB}{{6}{12}{Experiment B: Noise sensitivity sweep results (mean $\pm $ std across 5 seeds)}{table.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces EKF estimation error time history with $3\sigma $ covariance envelope for the baseline angles-only configuration. (a--c) Position error components. (d--f) Velocity error components. The estimation error remains bounded within the $3\sigma $ envelope throughout the engagement, confirming consistent filter performance.}}{13}{figure.5}\protected@file@percent }
\newlabel{fig:ekf_error}{{5}{13}{EKF estimation error time history with $3\sigma $ covariance envelope for the baseline angles-only configuration. (a--c) Position error components. (d--f) Velocity error components. The estimation error remains bounded within the $3\sigma $ envelope throughout the engagement, confirming consistent filter performance}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Sensor noise sensitivity analysis — the speed-softness trade-off. (a) Capture time and terminal relative velocity versus $\sigma _\theta $ (dual $y$-axis): a 100$\times $ noise increase reduces approach time by a factor of 2.3 but increases terminal $v_{\text  {rel}}$ by a factor of ${\sim }$20 (0.09~m/s $\to $ 1.76~m/s). The dotted reference lines mark full-information SDRE baselines. (b) Terminal $v_{\text  {rel}}$ boxplot across seeds per noise level, with the 2~m/s soft-rendezvous safety threshold and full-information reference. Variance grows substantially above $\sigma _\theta = 0.01^\circ $. (c) EKF position RMSE versus $\sigma _\theta $, showing estimation error saturation above ${\sim }0.02^\circ $. (d) Thrust mean and peak versus $\sigma _\theta $: peak thrust remains constant at ${\sim }1.96$~m/s$^2$, while mean thrust increases monotonically with noise.}}{14}{figure.6}\protected@file@percent }
\newlabel{fig:noise_sens}{{6}{14}{Sensor noise sensitivity analysis — the speed-softness trade-off. (a) Capture time and terminal relative velocity versus $\sigma _\theta $ (dual $y$-axis): a 100$\times $ noise increase reduces approach time by a factor of 2.3 but increases terminal $v_{\text {rel}}$ by a factor of ${\sim }$20 (0.09~m/s $\to $ 1.76~m/s). The dotted reference lines mark full-information SDRE baselines. (b) Terminal $v_{\text {rel}}$ boxplot across seeds per noise level, with the 2~m/s soft-rendezvous safety threshold and full-information reference. Variance grows substantially above $\sigma _\theta = 0.01^\circ $. (c) EKF position RMSE versus $\sigma _\theta $, showing estimation error saturation above ${\sim }0.02^\circ $. (d) Thrust mean and peak versus $\sigma _\theta $: peak thrust remains constant at ${\sim }1.96$~m/s$^2$, while mean thrust increases monotonically with noise}{figure.6}{}}
